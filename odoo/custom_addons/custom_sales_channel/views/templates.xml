<odoo>
    <data>
      <template id="report_invoice_sale_channel"
                inherit_id="account.report_invoice_document">

        <xpath expr="//span[@t-field='o.payment_reference']/.."
              position="before">

          <t t-if="o.sale_channel_id">
            <div t-attf-class="#{'col-auto col-3 mw-100' if report_type != 'html' else 'col'} mb-2"
                name="sale_channel_id">
              <strong>Canal de ventas:</strong>
              <span t-field="o.sale_channel_id.name"/>
            </div>
          </t>

        </xpath>
      </template>
    </data>
</odoo>
