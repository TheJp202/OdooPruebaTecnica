<odoo>
  <data>
  <!--Canales de Ventas-->
  <record id="view_sale_channel_tree" model="ir.ui.view">
    <field name="name">sale.channel.tree</field>
    <field name="model">sale.channel</field>
    <field name="arch" type="xml">
      <tree>
        <field name="name"/>
      </tree>
    </field>
  </record>

  <record id="view_sale_channel_form" model="ir.ui.view">
    <field name="name">sale.channel.form</field>
    <field name="model">sale.channel</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="name"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>
  
  <record id="action_sale_channel" model="ir.actions.act_window">
    <field name="name">Canales de ventas</field>
    <field name="res_model">sale.channel</field>
    <field name="view_mode">tree,form</field>
  </record>

  <menuitem id="menu_sale_channel_root"
            name="Canales de ventas"
            parent="account.menu_finance"
            action="action_sale_channel"
            sequence="30"/>

  <!--Factura-->
  <record id="view_move_form_inherit_sale_channel" model="ir.ui.view">
    <field name="name">account.move.form.sale.channel</field>
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_move_form"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='invoice_user_id']" position="after">
        <field name="sale_channel_id"/>
      </xpath>
    </field>
  </record>

  </data>
</odoo>
