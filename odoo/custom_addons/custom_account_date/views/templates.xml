<odoo>
    <data>
      <template id="report_invoice_date_choice"
                inherit_id="account.report_invoice_document">

        <xpath expr="//div[@name='invoice_date']" position="replace">

          <t t-if="o.x_emission_datetime">
            <div t-attf-class="#{'col-auto col-3 mw-100' if report_type != 'html' else 'col'} mb-2"
                name="emission_datetime">
              <t t-set="label">
                <t t-if="o.move_type == 'out_invoice'">Fecha de emisión:</t>
                <t t-elif="o.move_type == 'out_refund'">Fecha rectificativa:</t>
                <t t-elif="o.move_type == 'out_receipt'">Fecha de emisión:</t>
                <t t-else="">Fecha:</t>
              </t>
              <strong><t t-esc="label"/></strong><br/>
              <span t-field="o.x_emission_datetime"
                    t-options='{"widget": "datetime", "tz": user.tz}'/>
            </div>
          </t>

          <t t-else="">
            <div t-attf-class="#{'col-auto col-3 mw-100' if report_type != 'html' else 'col'} mb-2"
                name="invoice_date">
              <t t-if="o.move_type == 'out_invoice'"><strong>Fecha de factura:</strong></t>
              <t t-elif="o.move_type == 'out_refund'"><strong>Fecha de rectificativa:</strong></t>
              <t t-elif="o.move_type == 'out_receipt'"><strong>Fecha de recibo:</strong></t>
              <t t-else=""><strong>Fecha:</strong></t><br/>
              <span t-field="o.invoice_date"
                    t-options='{"widget": "date"}'/>
            </div>
          </t>

        </xpath>

      </template>
    </data>
</odoo>
