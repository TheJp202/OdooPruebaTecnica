<odoo>
  <data>
    <record id="view_move_form_inherit_serie" model="ir.ui.view">
      <field name="name">account.move.form.series</field>
      <field name="model">account.move</field>
      <field name="inherit_id" ref="account.view_move_form"/>
      <field name="arch" type="xml">
        <xpath expr="//field[@name='invoice_date']" position="after">
          <field name="x_invoice_serie" readonly="1"/>
          <field name="x_invoice_correlative" readonly="1"/>
        </xpath>
      </field>
    </record>

  </data>
</odoo>
