<odoo>
    <data>
      <template id="report_invoice_serie_correlative"
                inherit_id="account.report_invoice_document">

        <xpath expr="//span[@t-field='o.payment_reference']/.." position="before">

          <t t-if="o.x_invoice_serie or o.x_invoice_correlative">
            <div t-attf-class="#{'col-auto col-3 mw-100' if report_type != 'html' else 'col'} mb-2"
                name="invoice_extra_numbers">

              <t t-if="o.x_invoice_serie">
                <strong>Serie:</strong>
                <span t-field="o.x_invoice_serie"/><br/>
              </t>

              <t t-if="o.x_invoice_correlative">
                <strong>Correlativo:</strong>
                <span t-field="o.x_invoice_correlative"/>
              </t>

            </div>
          </t>

        </xpath>
      </template>
    </data>
</odoo>
